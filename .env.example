# Copiar a .env y ajustar. NUNCA poner access keys aquí: se leen del perfil del AWS CLI.

# --- AWS ---
AWS_PROFILE=
AWS_REGION=us-east-2
# Vacío = AWS real. Para desarrollar sin gastar: http://localhost:4566 (LocalStack/moto)
AWS_ENDPOINT_URL=

# --- PostgreSQL (docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finops
POSTGRES_USER=finops
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_SECRET

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_SECRET
